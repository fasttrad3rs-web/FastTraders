{
  "root": true,
  "extends": ["next/core-web-vitals", "eslint-config-prettier"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "prefer-const": "error",
    "no-var": "error",
    "@next/next/no-img-element": "error"
  },
  "ignorePatterns": ["node_modules/", ".next/", "out/", "next-env.d.ts"]
}
