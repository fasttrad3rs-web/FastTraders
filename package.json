{
  "name": "fast-traders",
  "version": "1.0.0",
  "private": true,
  "description": "Fast Traders \u2014 industrial & electrical equipment e-commerce + RFQ platform (Lahore, Pakistan)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm:start:server\" \"npm:start:client\"",
    "start:client": "npm --workspace client run start",
    "start:server": "npm --workspace server run start",
    "lint": "npm --workspace client run lint && npm --workspace server run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck",
    "verify": "node scripts/verify/catalog-pivot.cjs && node scripts/verify/commerce-audit.cjs",
    "doctor": "npm --workspace server run doctor",
    "seed:dryrun": "npm --workspace server run seed:dryrun",
    "seed": "npm --workspace server run seed",
    "seed:live": "npm --workspace server run seed:live",
    "install:all": "npm install",
    "audit:commerce": "node scripts/verify/commerce-audit.cjs",
    "verify:cloudinary": "npm --workspace server run verify:cloudinary",
    "test": "npm --workspace server run test",
    "test:leak": "npm --workspace server run test -- price-leak",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run verify && npm run build:client && npm run verify:bundle",
    "verify:bundle": "node scripts/verify/bundle-scan.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
