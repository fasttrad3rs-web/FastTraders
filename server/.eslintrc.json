{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    /*
     * Both projects. The build config excludes `src/__tests__`, so listing it
     * alone makes type-aware linting fail on every test file with "not found
     * in any of the provided project(s)" — which is what `npm run lint` was
     * doing before anyone read past the first error.
     *
     * `tsconfig.scripts.json` is here for the same reason: `scripts/` was in no
     * project either, so the editor reported a parse error on every
     * maintenance script while `npm run lint` — scoped to `src/` — stayed
     * green. That gap is why VS Code showed 34 problems against a clean CLI.
     */
    "project": ["./tsconfig.json", "./tsconfig.test.json", "./tsconfig.scripts.json"]
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "eslint-config-prettier"
  ],
  "env": { "node": true, "es2022": true },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/explicit-function-return-type": [
      "warn",
      { "allowExpressions": true, "allowTypedFunctionExpressions": true }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "prefer-const": "error",
    "no-var": "error"
  },
  "ignorePatterns": ["dist/", "node_modules/"]
}
