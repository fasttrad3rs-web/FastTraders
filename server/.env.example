# ----------------------------------------------------------------------------
# Fast Traders — SERVER environment
# Copy to `.env` and fill in. Validated with Zod at boot (src/config/env.ts):
# the process exits with code 1 if anything required is missing or malformed.
# NEVER commit the real .env.
# ----------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# macOS AirPlay Receiver listens on 5000, so the API uses 5050. Change it
# here and in client/.env.local together, or every request 404s.
PORT=5050
NODE_ENV=development

# --- Database ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/fast_traders

# --- Auth -------------------------------------------------------------------
# Use long random strings, e.g. `openssl rand -base64 48`. Minimum 32 chars.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_32_chars
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

# --- CORS / links -----------------------------------------------------------
# Comma-separate to whitelist multiple origins (e.g. preview deployments).
CLIENT_URL=http://localhost:3000

# --- Cloudinary (product images) --------------------------------------------
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_FOLDER=fast-traders

# --- SMTP (Nodemailer) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fasttrad3rs@gmail.com
SMTP_PASS=replace_with_app_password
SMTP_FROM="Fast Traders <fasttrad3rs@gmail.com>"

# --- Ops --------------------------------------------------------------------
# Inbox that receives enquiry and RFQ notifications.
ADMIN_EMAIL=fasttrad3rs@gmail.com
LOG_LEVEL=debug

# Optional: password for the admin account created by `npm run seed`.
# If omitted, the seeder generates one and prints it exactly once.
SEED_ADMIN_PASSWORD=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Optional integrations --------------------------------------------------
# Both are off unless set, and the app runs fully without either. See README.

# reCAPTCHA v3. A low score flags an inquiry for staff; it never rejects it.
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# Twilio WhatsApp/SMS alert to the counter phone. All three needed together.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_ALERT_TO=+923244234990

# --- Storefront cache invalidation -------------------------------------
# Both optional. Unset means the API never calls the front end and the
# catalogue falls back to its ISR window — a deactivated product then stays
# visible for up to five minutes. Set both in production.
# The secret must match REVALIDATE_SECRET in the client's environment.
REVALIDATE_URL=https://www.fasttraders.co/api/revalidate
REVALIDATE_SECRET=
