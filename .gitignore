next-env.d.ts

# env
#
# `.env*` rather than a list of known names. The list only covered the files
# somebody thought of: a `cp .env .env.bak` before editing produced a file
# holding live database and SMTP credentials that git would happily have
# committed. Anything starting `.env` is assumed to hold secrets, and the one
# exception is re-included below.
.env*
!.env.example

# Editor and tooling backups, which also tend to shadow real files.
*.bak
*.orig
*~

